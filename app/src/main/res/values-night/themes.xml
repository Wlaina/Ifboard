<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.FcitxAppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Ifboard "暖纸 · 液态玻璃": 深色模式令牌（统一使用 brand 强调色） -->
        <item name="colorPrimary">@color/ifb_brand</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorPrimaryContainer">#FF3D2A22</item>
        <item name="colorOnPrimaryContainer">#FFF6DFD5</item>
        <item name="colorSecondary">@color/ifb_brand</item>
        <item name="colorSecondaryContainer">#FF3D2A22</item>
        <item name="colorOnSecondaryContainer">#FFF6DFD5</item>
        <item name="colorTertiary">@color/ifb_sage</item>
        <item name="colorError">@color/ifb_error</item>
        <item name="colorSurface">@color/ifb_canvas</item>
        <item name="colorOnSurface">@color/ifb_text</item>
        <item name="colorOnSurfaceVariant">@color/ifb_text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/ifb_surface</item>
        <item name="colorSurfaceContainerLow">@color/ifb_surface</item>
        <item name="colorSurfaceContainer">@color/ifb_canvas</item>
        <item name="colorSurfaceContainerHigh">#FF2E2E2B</item>
        <item name="colorSurfaceContainerHighest">#FF2E2E2B</item>
        <item name="colorOutline">@color/ifb_border_strong</item>
        <item name="colorOutlineVariant">@color/ifb_border</item>
        <item name="android:colorBackground">@color/ifb_canvas</item>
        <item name="android:windowBackground">@color/ifb_canvas</item>
        <item name="android:textColorPrimary">@color/ifb_text</item>
        <item name="android:textColorSecondary">@color/ifb_text_secondary</item>
        <item name="android:textColorHint">@color/ifb_muted</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="alertDialogTheme">@style/Theme.Ifboard.AlertDialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Ifboard.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Ifboard.AlertDialog</item>
        <item name="colorLogFatal">@color/red_A700</item>
        <item name="colorLogError">@color/red_400</item>
        <item name="colorLogWarning">@color/yellow_500</item>
        <item name="colorLogInfo">@color/blue_500</item>
        <item name="colorLogDebug">@color/grey_400</item>
        <item name="colorLogVerbose">@color/grey_400</item>
    </style>

    <style name="Theme.Ifboard.AlertDialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="dialogCornerRadius">24dp</item>
        <item name="colorSurface">@color/ifb_surface</item>
        <item name="colorPrimary">@color/ifb_brand</item>
        <item name="colorOnSurface">@color/ifb_text</item>
        <item name="colorOnSurfaceVariant">@color/ifb_text_secondary</item>
        <item name="android:textColorPrimary">@color/ifb_text</item>
        <item name="android:textColorSecondary">@color/ifb_text_secondary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Ifboard.DialogTitle</item>
    </style>

    <style name="ThemeOverlay.Ifboard.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="dialogCornerRadius">24dp</item>
        <item name="colorSurface">@color/ifb_surface</item>
        <item name="colorSurfaceContainerHigh">@color/ifb_surface</item>
        <item name="colorPrimary">@color/ifb_brand</item>
        <item name="colorOnSurface">@color/ifb_text</item>
        <item name="colorOnSurfaceVariant">@color/ifb_text_secondary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Ifboard.DialogTitle</item>
    </style>

    <style name="Theme.DialogTheme" parent="@android:style/Theme.DeviceDefault.Dialog" />

    <style name="InputViewSnackbarTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar" />
</resources>
