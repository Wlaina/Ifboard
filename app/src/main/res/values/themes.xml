<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.FcitxAppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Ifboard "warm paper": warm neutrals, one terracotta accent -->
        <item name="colorPrimary">#FFD97757</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorPrimaryContainer">#FFF6DFD5</item>
        <item name="colorOnPrimaryContainer">#FF5A2A17</item>
        <item name="colorSecondary">#FFC6613F</item>
        <item name="colorSecondaryContainer">#FFF6DFD5</item>
        <item name="colorOnSecondaryContainer">#FF5A2A17</item>
        <item name="colorTertiary">#FF7D8B6A</item>
        <item name="colorError">#FFB53333</item>
        <item name="colorSurface">#FFF5F4ED</item>
        <item name="colorOnSurface">#FF141413</item>
        <item name="colorOnSurfaceVariant">#FF5E5D59</item>
        <item name="colorSurfaceContainerLowest">#FFFAF9F5</item>
        <item name="colorSurfaceContainerLow">#FFFAF9F5</item>
        <item name="colorSurfaceContainer">#FFF5F4ED</item>
        <item name="colorSurfaceContainerHigh">#FFEFEDE4</item>
        <item name="colorSurfaceContainerHighest">#FFEFEDE4</item>
        <item name="colorOutline">#FFE3DACC</item>
        <item name="colorOutlineVariant">#FFF0EEE6</item>
        <item name="android:colorBackground">#FFF5F4ED</item>
        <item name="android:windowBackground">@color/ifb_canvas</item>
        <item name="android:textColorPrimary">#FF141413</item>
        <item name="android:textColorSecondary">#FF5E5D59</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorLogFatal">@color/red_A700</item>
        <item name="colorLogError">@color/red_400</item>
        <item name="colorLogWarning">@color/yellow_800</item>
        <item name="colorLogInfo">@color/blue_500</item>
        <item name="colorLogDebug">@color/grey_700</item>
        <item name="colorLogVerbose">@color/grey_700</item>
    </style>

    <style name="Theme.InputViewTheme" parent="@android:style/Theme.DeviceDefault.Settings" />

    <style name="Theme.DialogTheme" parent="@android:style/Theme.DeviceDefault.Light.Dialog" />

    <style name="InputViewSnackbarTheme" parent="Theme.MaterialComponents.Light.NoActionBar" />

    <!-- Ifboard pages that need an action bar -->
    <style name="Theme.Ifboard.Page" parent="Theme.FcitxAppTheme">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>

    <!-- serif titles, weight from size not boldness -->
    <style name="TextAppearance.Ifboard.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
</resources>