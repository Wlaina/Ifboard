<Application x:Class="IfboardWin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 默认回退占位色（启动后由 WarmPaperPalette 动态刷新） -->
            <SolidColorBrush x:Key="WpCanvasBrush" Color="#F5F4ED" />
            <SolidColorBrush x:Key="WpSurfaceBrush" Color="#FAF9F5" />
            <SolidColorBrush x:Key="WpCardBgBrush" Color="#F5FFFFFF" />
            <SolidColorBrush x:Key="WpCardSubtleBrush" Color="#EBFAF9F5" />
            <SolidColorBrush x:Key="WpGlassBgBrush" Color="#EEFAF9F5" />
            <SolidColorBrush x:Key="WpGlassBorderBrush" Color="#B0FFFFFF" />
            <SolidColorBrush x:Key="WpNavPillBgBrush" Color="#D6F0EEE6" />
            <SolidColorBrush x:Key="WpTextBrush" Color="#141413" />
            <SolidColorBrush x:Key="WpTextSecondaryBrush" Color="#5E5D59" />
            <SolidColorBrush x:Key="WpMutedBrush" Color="#87867F" />
            <SolidColorBrush x:Key="WpDividerBrush" Color="#EFECE3" />
            <SolidColorBrush x:Key="WpBorderStrongBrush" Color="#E3DACC" />
            <SolidColorBrush x:Key="WpInputBgBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="WpBrandBrush" Color="#D97757" />
            <SolidColorBrush x:Key="WpBrandInkBrush" Color="#C6613F" />
            <SolidColorBrush x:Key="WpBrandSoftBrush" Color="#21D97757" />
            <SolidColorBrush x:Key="WpSageBrush" Color="#7D8B6A" />
            <SolidColorBrush x:Key="WpSageSoftBrush" Color="#227D8B6A" />
            <SolidColorBrush x:Key="WpErrorBrush" Color="#B53333" />
            <SolidColorBrush x:Key="WpErrorSoftBrush" Color="#1FB53333" />
            <SolidColorBrush x:Key="WpAmberBrush" Color="#D97706" />
            <SolidColorBrush x:Key="WpSwitchOffTrackBrush" Color="#DDD8CC" />
            <SolidColorBrush x:Key="WpSwitchThumbBrush" Color="#FAF9F5" />
            <Color x:Key="WpGlow1Color">#3CD97757</Color>
            <Color x:Key="WpGlow2Color">#2E7D8B6A</Color>
            <Color x:Key="WpGlow3Color">#28D6AA68</Color>
            <RadialGradientBrush x:Key="WpGlow1Brush">
                <GradientStop Color="#40D97757" Offset="0" />
                <GradientStop Color="#00D97757" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="WpGlow2Brush">
                <GradientStop Color="#307D8B6A" Offset="0" />
                <GradientStop Color="#007D8B6A" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="WpGlow3Brush">
                <GradientStop Color="#2CD6AA68" Offset="0" />
                <GradientStop Color="#00D6AA68" Offset="1" />
            </RadialGradientBrush>

            <!-- 全局字体与基础文本 -->
            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI" />
                <Setter Property="Foreground" Value="{DynamicResource WpTextBrush}" />
            </Style>

            <!-- 液态玻璃卡片容器（零着色器高帧率实现，兼顾暖纸层次感） -->
            <Style x:Key="GlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource WpCardBgBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WpGlassBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <!-- 分区眉题标题 -->
            <Style x:Key="SectionEyebrowStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource WpBrandInkBrush}" />
                <Setter Property="Margin" Value="4,2,0,7" />
            </Style>

            <!-- 设置条目标题 & 说明 -->
            <Style x:Key="RowTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource WpTextBrush}" />
            </Style>
            <Style x:Key="RowDescStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource WpTextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,2,16,0" />
            </Style>

            <!-- 分隔线 -->
            <Style x:Key="CardDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{DynamicResource WpDividerBrush}" />
                <Setter Property="Margin" Value="0,5.5" />
            </Style>

            <!-- 细条极简暖纸滚动条 -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="7" />
                <Setter Property="MinWidth" Value="7" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBd"
                                                            CornerRadius="3.5"
                                                            Background="{DynamicResource WpBorderStrongBrush}"
                                                            Opacity="0.65"
                                                            Margin="1,2" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource WpBrandBrush}" />
                                                            <Setter TargetName="ThumbBd" Property="Opacity" Value="0.85" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 陶土橙圆润滑块 -->
            <Style TargetType="Slider">
                <Setter Property="Height" Value="24" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Border Height="4" CornerRadius="2"
                                        Background="{DynamicResource WpSwitchOffTrackBrush}" />
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" CornerRadius="2" Background="{DynamicResource WpBrandBrush}" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Width="16" Height="16"
                                                             Fill="{DynamicResource WpSwitchThumbBrush}"
                                                             Stroke="{DynamicResource WpBrandBrush}"
                                                             StrokeThickness="2.5" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 陶土橙主按钮 -->
            <Style x:Key="BrandButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource WpBrandBrush}" />
                <Setter Property="Foreground" Value="#FAF9F5" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="11"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WpBrandInkBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.48" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 暖纸描边次按钮 -->
            <Style x:Key="GhostButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource WpCardSubtleBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource WpTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WpBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WpBrandSoftBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WpBrandBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.48" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 胶囊筛选芯片 RadioButton -->
            <Style x:Key="NavTabRadioStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource WpTextSecondaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="1"
                                    BorderBrush="Transparent"
                                    CornerRadius="12"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WpNavPillBgBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WpBrandSoftBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WpBrandBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource WpBrandInkBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 选项芯片 RadioButton / CheckBox 统一样式 -->
            <Style x:Key="ChipRadioStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource WpTextSecondaryBrush}" />
                <Setter Property="Background" Value="{DynamicResource WpCardSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WpBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WpBrandBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WpBrandBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WpBrandBrush}" />
                                    <Setter Property="Foreground" Value="#FAF9F5" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 暖纸液态玻璃 胶囊开关（与手机端 Material3 / WarmPaper 一致） -->
            <Style x:Key="PillSwitchStyle" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Width="46" Height="26">
                                <Border x:Name="Track"
                                        CornerRadius="13"
                                        Background="{DynamicResource WpSwitchOffTrackBrush}"
                                        BorderBrush="{DynamicResource WpBorderStrongBrush}"
                                        BorderThickness="1" />
                                <Border x:Name="Thumb"
                                        Width="20" Height="20"
                                        CornerRadius="10"
                                        HorizontalAlignment="Left"
                                        Margin="3,0,0,0"
                                        BorderBrush="{DynamicResource WpBorderStrongBrush}"
                                        BorderThickness="0.5"
                                        Background="{DynamicResource WpSwitchThumbBrush}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource WpBrandBrush}" />
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource WpBrandBrush}" />
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 暖纸文本框 & 密码框 -->
            <Style x:Key="WarmTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource WpInputBgBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource WpTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WpBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="CaretBrush" Value="{DynamicResource WpBrandBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WpBrandBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WarmPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource WpInputBgBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource WpTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WpBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="CaretBrush" Value="{DynamicResource WpBrandBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WpBrandBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 暖纸液态玻璃系统托盘右键菜单 -->
            <Style x:Key="WpTrayContextMenuStyle" TargetType="ContextMenu">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="HasDropShadow" Value="True" />
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{DynamicResource WpTextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{DynamicResource WpSurfaceBrush}"
                                    BorderBrush="{DynamicResource WpBorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="5"
                                    MinWidth="236">
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WpTrayMenuItemStyle" TargetType="MenuItem">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Foreground" Value="{DynamicResource WpTextBrush}" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="CheckMark"
                                          Grid.Column="0"
                                          Data="M 0,4.2 L 3.3,7.5 L 9.2,1.0"
                                          Stroke="{DynamicResource WpBrandInkBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Visibility="Collapsed" />
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{DynamicResource WpBrandInkBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WpBrandSoftBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource WpBrandInkBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WpTraySeparatorStyle" TargetType="Separator">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Margin" Value="8,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Background="{DynamicResource WpDividerBrush}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
