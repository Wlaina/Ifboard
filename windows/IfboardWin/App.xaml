<Application x:Class="IfboardWin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:IfboardWin.Theme"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <theme:PillRadiusConverter x:Key="PillRadius" />
            <!-- 默认回退占位色（启动后由 WarmPaperPalette 动态刷新） -->
            <SolidColorBrush x:Key="WpCanvasBrush" Color="#F5F4ED" />
            <SolidColorBrush x:Key="WpSurfaceBrush" Color="#FAF9F5" />
            <SolidColorBrush x:Key="WpCardBgBrush" Color="#C7FFFFFF" />
            <SolidColorBrush x:Key="WpCardSubtleBrush" Color="#EBFAF9F5" />
            <SolidColorBrush x:Key="WpGlassBgBrush" Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="WpGlassBorderBrush" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="WpNavPillBgBrush" Color="#D6F0EEE6" />
            <SolidColorBrush x:Key="WpTextBrush" Color="#141413" />
            <SolidColorBrush x:Key="WpTextSecondaryBrush" Color="#5E5D59" />
            <SolidColorBrush x:Key="WpMutedBrush" Color="#87867F" />
            <SolidColorBrush x:Key="WpDividerBrush" Color="#F0EEE6" />
            <SolidColorBrush x:Key="WpBorderStrongBrush" Color="#E3DACC" />
            <SolidColorBrush x:Key="WpInputBgBrush" Color="#FAF9F5" />
            <SolidColorBrush x:Key="WpBrandBrush" Color="#D97757" />
            <SolidColorBrush x:Key="WpBrandInkBrush" Color="#C6613F" />
            <SolidColorBrush x:Key="WpBrandSoftBrush" Color="#21D97757" />
            <SolidColorBrush x:Key="WpSageBrush" Color="#7D8B6A" />
            <SolidColorBrush x:Key="WpSageSoftBrush" Color="#227D8B6A" />
            <SolidColorBrush x:Key="WpErrorBrush" Color="#B53333" />
            <SolidColorBrush x:Key="WpErrorSoftBrush" Color="#1FB53333" />
            <SolidColorBrush x:Key="WpAmberBrush" Color="#D97706" />
            <SolidColorBrush x:Key="WpAmberSoftBrush" Color="#1AD97706" />
            <SolidColorBrush x:Key="WpSwitchOffTrackBrush" Color="#E3DACC" />
            <SolidColorBrush x:Key="WpSwitchThumbBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="WpSegmentOnBrush" Color="#FFFFFF" />
            <Color x:Key="WpShadowColor">#3C2814</Color>
            <RadialGradientBrush x:Key="WpGlow1Brush">
                <GradientStop Color="#20D97757" Offset="0" />
                <GradientStop Color="#00D97757" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="WpGlow2Brush">
                <GradientStop Color="#187D8B6A" Offset="0" />
                <GradientStop Color="#007D8B6A" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="WpGlow3Brush">
                <GradientStop Color="#16D6AA68" Offset="0" />
                <GradientStop Color="#00D6AA68" Offset="1" />
            </RadialGradientBrush>

            <!-- 字体：界面无衬线 / 标题衬线 / 编码与数字等宽 -->
            <FontFamily x:Key="WpUiFont">Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="WpSerifFont">Georgia, Noto Serif SC, Source Han Serif SC, SimSun</FontFamily>
            <FontFamily x:Key="WpMonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

            <!-- 缓动：柔和 / 回弹 -->
            <CubicEase x:Key="WpEaseSoft" EasingMode="EaseOut" />

            <!-- 键盘焦点：半透明主题色内描边，去掉默认黑色虚线框 -->
            <Style x:Key="WpFocusVisual">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border CornerRadius="12" BorderThickness="1.5" Margin="-2"
                                    BorderBrush="{DynamicResource WpBrandBrush}" Opacity="0.55" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="WpPillFocusVisual">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" BorderThickness="1.5" Margin="-2"
                                    BorderBrush="{DynamicResource WpBrandBrush}" Opacity="0.55" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 全局字体与基础文本 -->
            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="{StaticResource WpUiFont}" />
                <Setter Property="Foreground" Value="{DynamicResource WpTextBrush}" />
            </Style>

            <!-- 页面大标题 / 卡片标题（衬线 500） -->
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource WpSerifFont}" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="FontSize" Value="26" />
                <Setter Property="Foreground" Value="{DynamicResource WpTextBrush}" />
            </Style>
            <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource WpMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,0,18" />
            </Style>
            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource WpSerifFont}" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="Foreground" Value="{DynamicResource WpTextBrush}" />
                <Setter Property="Margin" Value="4,0,0,8" />
            </Style>

            <!-- 设置卡片：半透明实色（不做实时毛玻璃，保证滚动流畅），20 圆角 -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource WpCardBgBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WpGlassBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="18,2" />
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>

            <!-- 卡片内的说明文字 / 小号辅助文字 -->
            <Style x:Key="HintTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{DynamicResource WpMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineHeight" Value="18" />
            </Style>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{DynamicResource WpTextSecondaryBrush}" />
                <Setter Property="Margin" Value="2,0,0,5" />
            </Style>

            <!-- 设置行：标题 + 12.5px 说明 + 右侧控件，最小高度 52，细线分隔 -->
            <Style TargetType="theme:SettingRow">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="theme:SettingRow">
                            <Border x:Name="RowRoot" Background="Transparent" CornerRadius="10" Margin="-8,0">
                                <Border x:Name="Sep" BorderThickness="0,0,0,1" Margin="8,0"
                                        BorderBrush="{DynamicResource WpDividerBrush}">
                                    <Grid MinHeight="36" Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                            <TextBlock Text="{TemplateBinding Title}" FontSize="14" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource WpTextBrush}" />
                                            <TextBlock x:Name="HintText" Text="{TemplateBinding Hint}"
                                                       Style="{StaticResource HintTextStyle}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ContentPresenter x:Name="Slot" Grid.Column="1" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Hint" Value="">
                                    <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="ShowSeparator" Value="False">
                                    <Setter TargetName="Sep" Property="BorderThickness" Value="0" />
                                </Trigger>
                                <Trigger Property="Stacked" Value="True">
                                    <Setter TargetName="Slot" Property="Grid.Column" Value="0" />
                                    <Setter TargetName="Slot" Property="Grid.Row" Value="1" />
                                    <Setter TargetName="Slot" Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter TargetName="Slot" Property="Margin" Value="0,10,0,2" />
                                </Trigger>
                                <Trigger Property="IsFlashing" Value="True">
                                    <Setter TargetName="RowRoot" Property="Background" Value="{DynamicResource WpBrandSoftBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 细条暖纸滚动条 -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="7" />
                <Setter Property="MinWidth" Value="7" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBd" CornerRadius="3.5" Margin="1,2"
                                                            Background="{DynamicResource WpBorderStrongBrush}" Opacity="0.8" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource WpBrandBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 细滑块：4px 轨道 + 18px 主题色圆钮 -->
            <Style TargetType="Slider">
                <Setter Property="Height" Value="24" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Border Height="4" CornerRadius="2" Background="{DynamicResource WpBorderStrongBrush}" />
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" CornerRadius="2" Background="{DynamicResource WpBrandBrush}" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid>
                                                        <Ellipse x:Name="Halo" Width="30" Height="30" Fill="{DynamicResource WpBrandSoftBrush}" Opacity="0" />
                                                        <Ellipse Width="18" Height="18" Fill="{DynamicResource WpBrandBrush}"
                                                                 Stroke="{DynamicResource WpSwitchThumbBrush}" StrokeThickness="2" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Halo" Property="Opacity" Value="1" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="PART_Track" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 胶囊按钮公共模板：按下缩到 .97，禁用 .5 -->
            <ControlTemplate x:Key="PillButtonTemplate" TargetType="Button">
                <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}"
                        Padding="{TemplateBinding Padding}"
                        RenderTransformOrigin="0.5,0.5">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Bd" Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- 主按钮：主题色底、白字 -->
            <Style x:Key="BrandButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource WpBrandBrush}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource WpPillFocusVisual}" />
                <Setter Property="Template" Value="{StaticResource PillButtonTemplate}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource WpBrandInkBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 普通按钮：surface 底加描边 -->
            <Style x:Key="GhostButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource WpSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource WpTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WpBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource WpPillFocusVisual}" />
                <Setter Property="Template" Value="{StaticResource PillButtonTemplate}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource WpBrandSoftBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource WpBrandBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 幽灵按钮：透明 -->
            <Style x:Key="TextButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource WpTextSecondaryBrush}" />
            </Style>

            <!-- 危险按钮：红字 -->
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                <Setter Property="Foreground" Value="{DynamicResource WpErrorBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource WpErrorSoftBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource WpErrorBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 步进器圆钮 -->
            <Style x:Key="StepperButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource WpMonoFont}" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <!-- 左侧导航项：图标（Tag 传入几何路径）+ 文字；选中底块由窗口里的滑块绘制 -->
            <Style x:Key="NavItemStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource WpTextSecondaryBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="GroupName" Value="MainNav" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource WpFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{TemplateBinding Tag}" Width="18" Height="18" Stretch="Uniform"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          VerticalAlignment="Center" />
                                    <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsChecked" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WpNavPillBgBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource WpTextBrush}" />
                                </MultiTrigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WpBrandInkBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 分段控件：外框 brand-soft 底，选中段白底带小阴影 -->
            <Style x:Key="SegmentHostStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource WpBrandSoftBrush}" />
                <Setter Property="CornerRadius" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" />
                <Setter Property="Padding" Value="3" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource WpTextSecondaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource WpPillFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WpTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WpSegmentOnBrush}" />
                                    <Setter TargetName="Bd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.12"
                                                              Color="#3C2814" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Foreground" Value="{DynamicResource WpTextBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 多选胶囊 Chip：选中时主题色描边 + 主题色文字 + brand-soft 底 -->
            <Style x:Key="ChipCheckStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource WpTextSecondaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource WpPillFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Bd" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                    Background="{DynamicResource WpSurfaceBrush}"
                                    BorderBrush="{DynamicResource WpBorderStrongBrush}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="Tick" Data="M 0,4.2 L 3.3,7.5 L 9.2,1.0" Width="10" Height="9"
                                          Stroke="{DynamicResource WpBrandInkBrush}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WpBrandBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WpBrandSoftBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WpBrandBrush}" />
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{DynamicResource WpBrandInkBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 开关：46×28 胶囊，打开时填主题色，白色圆钮带小阴影，0.2s 滑动 -->
            <Style x:Key="PillSwitchStyle" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource WpPillFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Width="46" Height="28" Background="Transparent">
                                <Border x:Name="Track" CornerRadius="14" Background="{DynamicResource WpSwitchOffTrackBrush}" />
                                <Border x:Name="Fill" CornerRadius="14" Background="{DynamicResource WpBrandBrush}" Opacity="0" />
                                <Ellipse x:Name="Thumb" Width="22" Height="22" HorizontalAlignment="Left" Margin="3,0,0,0"
                                         Fill="{DynamicResource WpSwitchThumbBrush}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbShift" X="0" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.22" Color="#000000" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X"
                                                                 To="18" Duration="0:0:0.2" EasingFunction="{StaticResource WpEaseSoft}" />
                                                <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X"
                                                                 To="0" Duration="0:0:0.2" EasingFunction="{StaticResource WpEaseSoft}" />
                                                <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 输入框 / 密码框：12 圆角，聚焦时主题色描边 + 3px brand-soft 光圈 -->
            <Style x:Key="WarmTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource WpInputBgBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource WpTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WpBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Padding" Value="11,8" />
                <Setter Property="CaretBrush" Value="{DynamicResource WpBrandBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource WpBrandBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Halo" CornerRadius="15" BorderThickness="3" BorderBrush="Transparent" Margin="-3">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="12" Padding="{TemplateBinding Padding}">
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WpBrandBrush}" />
                                    <Setter TargetName="Halo" Property="BorderBrush" Value="{DynamicResource WpBrandSoftBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WarmPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource WpInputBgBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource WpTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WpBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Padding" Value="11,8" />
                <Setter Property="CaretBrush" Value="{DynamicResource WpBrandBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource WpBrandBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="Halo" CornerRadius="15" BorderThickness="3" BorderBrush="Transparent" Margin="-3">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="12" Padding="{TemplateBinding Padding}">
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WpBrandBrush}" />
                                    <Setter TargetName="Halo" Property="BorderBrush" Value="{DynamicResource WpBrandSoftBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 顶部设置搜索框：胶囊形，左侧放大镜，Tag 为占位文字 -->
            <Style x:Key="SearchBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource WpTextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="CaretBrush" Value="{DynamicResource WpBrandBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource WpBrandBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" Height="40" Padding="14,0"
                                    Background="{DynamicResource WpGlassBgBrush}"
                                    BorderBrush="{DynamicResource WpGlassBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M10.5,3 A7.5,7.5 0 1 1 10.49,3 Z M16,16 L21,21" Width="15" Height="15" Stretch="Uniform"
                                          Stroke="{DynamicResource WpMutedBrush}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Placeholder" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Text="{TemplateBinding Tag}" Foreground="{DynamicResource WpMutedBrush}"
                                               IsHitTestVisible="False" Visibility="Collapsed" />
                                    <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WpBrandBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 皮肤卡片：14 圆角，选中外圈 2px 主题色描边 + 对勾徽标 -->
            <Style x:Key="SkinCardStyle" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource WpFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Border x:Name="Bd" CornerRadius="14" BorderThickness="1" Padding="10"
                                        Background="{DynamicResource WpSurfaceBrush}"
                                        BorderBrush="{DynamicResource WpBorderStrongBrush}">
                                    <ContentPresenter />
                                </Border>
                                <Border x:Name="Badge" Width="20" Height="20" CornerRadius="10" Margin="0,-6,-6,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="{DynamicResource WpBrandBrush}" Visibility="Collapsed">
                                    <Path Data="M 0,4.2 L 3.3,7.5 L 9.2,1.0" Width="10" Height="9" Stroke="White" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WpBrandBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WpBrandBrush}" />
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                    <Setter TargetName="Bd" Property="Padding" Value="9" />
                                    <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 提示框：左侧 3px 竖条 + 极淡底色 -->
            <Style x:Key="NoteBoxStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource WpAmberSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WpAmberBrush}" />
                <Setter Property="BorderThickness" Value="3,0,0,0" />
                <Setter Property="CornerRadius" Value="0,12,12,0" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="Margin" Value="0,10,0,10" />
            </Style>

            <!-- 细进度条 -->
            <Style x:Key="ThinProgressStyle" TargetType="ProgressBar">
                <Setter Property="Height" Value="3" />
                <Setter Property="Foreground" Value="{DynamicResource WpBrandBrush}" />
                <Setter Property="Background" Value="{DynamicResource WpBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- 暖纸托盘右键菜单（菜单 16 圆角，菜单项 10 圆角） -->
            <Style x:Key="WpTrayContextMenuStyle" TargetType="ContextMenu">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="HasDropShadow" Value="True" />
                <Setter Property="FontFamily" Value="{StaticResource WpUiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource WpTextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{DynamicResource WpSurfaceBrush}"
                                    BorderBrush="{DynamicResource WpBorderStrongBrush}"
                                    BorderThickness="1" CornerRadius="16" Padding="6" MinWidth="240">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WpTrayMenuItemStyle" TargetType="MenuItem">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Foreground" Value="{DynamicResource WpTextBrush}" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="CheckMark" Grid.Column="0" Data="M 0,4.2 L 3.3,7.5 L 9.2,1.0"
                                          Stroke="{DynamicResource WpBrandInkBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed" />
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{DynamicResource WpBrandInkBrush}" />
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WpBrandSoftBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource WpBrandInkBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WpTraySeparatorStyle" TargetType="Separator">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Margin" Value="10,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Background="{DynamicResource WpBorderStrongBrush}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
