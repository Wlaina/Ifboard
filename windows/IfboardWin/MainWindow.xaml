<Window x:Class="IfboardWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ifboard 控制中心"
        Width="980" Height="780"
        MinWidth="840" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WpCanvasBrush}"
        Foreground="{DynamicResource WpTextBrush}"
        Icon="pack://application:,,,/Assets/ifboard.ico">

    <Grid ClipToBounds="True">
        <!-- 暖纸液态玻璃柔和氛围光晕层（静态渲染，避免常驻离屏显存缓存） -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="520" Height="520" Canvas.Left="-140" Canvas.Top="-160"
                     Fill="{DynamicResource WpGlow1Brush}" />
            <Ellipse Width="480" Height="480" Canvas.Left="540" Canvas.Top="-120"
                     Fill="{DynamicResource WpGlow2Brush}" />
            <Ellipse Width="460" Height="460" Canvas.Left="120" Canvas.Top="410"
                     Fill="{DynamicResource WpGlow3Brush}" />
        </Canvas>

        <Grid Margin="18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧半透明磨砂玻璃导航栏 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource WpGlassBgBrush}"
                    BorderBrush="{DynamicResource WpGlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="14,16">

                <DockPanel LastChildFill="True">
                    <!-- 顶部品牌区 -->
                    <StackPanel DockPanel.Dock="Top" Margin="4,0,4,18">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="10"
                                    BorderBrush="#55FFFDF9" BorderThickness="0.8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#E38667" Offset="0" />
                                        <GradientStop Color="#BC5736" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Margin="5.5">
                                    <Border Background="#FAF9F5" CornerRadius="6.5">
                                        <Grid>
                                            <TextBlock Text="If"
                                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                                       FontSize="15.5"
                                                       FontWeight="Bold"
                                                       Foreground="#C6613F"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="-1,-1.5,0,0" />
                                            <Ellipse Width="4.8" Height="4.8"
                                                     Fill="#7D8B6A"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Top"
                                                     Margin="0,3.2,3.2,0" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ifboard" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource WpTextBrush}" />
                                <TextBlock Text="Windows 小狼毫伴侣" FontSize="11.5"
                                           Foreground="{DynamicResource WpMutedBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Background="{DynamicResource WpBrandSoftBrush}"
                                CornerRadius="8" Padding="9,4" Margin="0,12,0,0"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="DeviceBadgeText"
                                       Text="公开版 v1.2.1"
                                       FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WpBrandInkBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- 底部快捷部署与系统信息 -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="2,12,2,0">
                        <Border Height="1" Background="{DynamicResource WpDividerBrush}" Margin="0,0,0,12" />
                        <Button x:Name="QuickDeployBtn" Style="{StaticResource BrandButtonStyle}"
                                Content="立即部署小狼毫"
                                Click="QuickDeploy_Click" />
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Margin="0,8,0,0"
                                Content="最小化至系统托盘"
                                Click="MinimizeToTray_Click" />
                    </StackPanel>

                    <!-- 主分组导航 -->
                    <StackPanel VerticalAlignment="Top">
                        <RadioButton x:Name="NavSyncRadio" Style="{StaticResource NavTabRadioStyle}"
                                     AutomationProperties.Name="同步与语法模型"
                                     GroupName="MainNav" IsChecked="True" Checked="NavTab_Checked">
                            <StackPanel>
                                <TextBlock Text="同步与语法模型" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="WebDAV · 备份恢复 · 万象" FontSize="11"
                                           Foreground="{DynamicResource WpMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavInputRadio" Style="{StaticResource NavTabRadioStyle}"
                                     AutomationProperties.Name="输入与方案"
                                     GroupName="MainNav" Checked="NavTab_Checked">
                            <StackPanel>
                                <TextBlock Text="输入与方案" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="全拼/双拼 · 模糊音 · 热键" FontSize="11"
                                           Foreground="{DynamicResource WpMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavSkinRadio" Style="{StaticResource NavTabRadioStyle}"
                                     AutomationProperties.Name="外观与皮肤"
                                     GroupName="MainNav" Checked="NavTab_Checked">
                            <StackPanel>
                                <TextBlock Text="外观与皮肤" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="陶土橙 · 系统主体色 · 预览" FontSize="11"
                                           Foreground="{DynamicResource WpMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavAboutRadio" Style="{StaticResource NavTabRadioStyle}"
                                     AutomationProperties.Name="工具与关于"
                                     GroupName="MainNav" Checked="NavTab_Checked">
                            <StackPanel>
                                <TextBlock Text="工具与关于" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="精简微软拼音 · 数据目录 · 版本" FontSize="11"
                                           Foreground="{DynamicResource WpMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 右侧内容面板 + 底部状态条 -->
            <DockPanel Grid.Column="2" LastChildFill="True">
                <!-- 底部状态提示横幅 -->
                <Border DockPanel.Dock="Bottom"
                        Background="{DynamicResource WpGlassBgBrush}"
                        BorderBrush="{DynamicResource WpGlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,10"
                        Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,10,0"
                                 Fill="{DynamicResource WpSageBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusBannerText"
                                       Text="就绪：可在上方调整配置并实时同步。"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource WpTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <ProgressBar x:Name="GlobalProgressBar"
                                         Height="4" Margin="0,5,0,0"
                                         Minimum="0" Maximum="100" Value="0"
                                         Foreground="{DynamicResource WpBrandBrush}"
                                         Background="{DynamicResource WpDividerBrush}"
                                         BorderThickness="0"
                                         Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock x:Name="StatusDetailText" Grid.Column="2"
                                   FontSize="11.5" Margin="12,0,0,0"
                                   Foreground="{DynamicResource WpMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 滚动视图区 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,6,0">
                    <Grid>
                        <!-- ══════════════════ TAB 1：同步与语法模型 ══════════════════ -->
                        <StackPanel x:Name="PageSync" Visibility="Visible">
                            <TextBlock Text="云端同步与词库迁移" Style="{StaticResource SectionEyebrowStyle}" />

                            <!-- 可选历史凭据快速导入提示条 -->
                            <Border x:Name="LegacyImportBanner"
                                    Style="{StaticResource GlassCardStyle}"
                                    Background="{DynamicResource WpBrandSoftBrush}"
                                    BorderBrush="{DynamicResource WpBrandBrush}"
                                    Visibility="Collapsed"
                                    Padding="14,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="检测到本机历史 webdav_config.json" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource WpBrandInkBrush}" />
                                        <TextBlock Text="可一键读取原有服务器与账号信息，并转存为本机 DPAPI 加密凭据。"
                                                   FontSize="12" Foreground="{DynamicResource WpTextSecondaryBrush}" Margin="0,2,12,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource BrandButtonStyle}"
                                            Content="一键填入" Click="ImportLegacyWebDav_Click" />
                                </Grid>
                            </Border>

                            <!-- WebDAV 配置卡 -->
                            <Border Style="{StaticResource GlassCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="WebDAV 多设备词库同步" FontSize="15.5" FontWeight="Bold" />
                                            <TextBlock Text="与手机端 Ifboard 共用同一云端结构，双向同步用户词频、造词与电脑整套个人配置。账号密码使用 Windows DPAPI 硬件级加密保存在本机。"
                                                       Style="{StaticResource RowDescStyle}" Margin="0,4,12,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource WpCardSubtleBrush}"
                                                BorderBrush="{DynamicResource WpBorderStrongBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="10,6" VerticalAlignment="Top">
                                            <TextBlock x:Name="LastSyncText" Text="上次同步：尚未同步"
                                                       FontSize="11.5" Foreground="{DynamicResource WpTextSecondaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource CardDividerStyle}" />

                                    <TextBlock Text="云盘服务商" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="默认推荐 Koofr（国内外稳定支持 WebDAV 应用密码），也可一键切换至坚果云或自定义 Nextcloud。"
                                               Style="{StaticResource RowDescStyle}" Margin="0,2,0,8" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <RadioButton x:Name="ProviderKoofrRadio" Style="{StaticResource ChipRadioStyle}"
                                                     GroupName="WebDavProvider" Content="Koofr（默认）"
                                                     Checked="ProviderRadio_Checked" />
                                        <RadioButton x:Name="ProviderJgyRadio" Style="{StaticResource ChipRadioStyle}"
                                                     GroupName="WebDavProvider" Content="坚果云"
                                                     Checked="ProviderRadio_Checked" />
                                        <RadioButton x:Name="ProviderCustomRadio" Style="{StaticResource ChipRadioStyle}"
                                                     GroupName="WebDavProvider" Content="自定义"
                                                     Checked="ProviderRadio_Checked" />
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="WebDAV 服务器地址" FontSize="12" Foreground="{DynamicResource WpTextSecondaryBrush}" Margin="0,0,0,4" />
                                            <TextBox x:Name="DavUrlBox" Style="{StaticResource WarmTextBoxStyle}"
                                                     TextChanged="DavField_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="云端同步目录名" FontSize="12" Foreground="{DynamicResource WpTextSecondaryBrush}" Margin="0,0,0,4" />
                                            <TextBox x:Name="DavDirBox" Style="{StaticResource WarmTextBoxStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="账号（邮箱）" FontSize="12" Foreground="{DynamicResource WpTextSecondaryBrush}" Margin="0,0,0,4" />
                                            <TextBox x:Name="DavUserBox" Style="{StaticResource WarmTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="应用专用密码（非登录密码）" FontSize="12" Foreground="{DynamicResource WpTextSecondaryBrush}" Margin="0,0,0,4" />
                                            <Grid>
                                                <PasswordBox x:Name="DavPassBox" Style="{StaticResource WarmPasswordBoxStyle}"
                                                             Padding="10,7,46,7" />
                                                <TextBox x:Name="DavPassVisibleBox" Style="{StaticResource WarmTextBoxStyle}"
                                                         Padding="10,7,46,7" Visibility="Collapsed" />
                                                <Button Content="显示" x:Name="TogglePassBtn"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Margin="0,0,6,0" Padding="8,3"
                                                        FontSize="11" Style="{StaticResource GhostButtonStyle}"
                                                        Click="TogglePassword_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <WrapPanel Margin="0,12,0,0">
                                        <Button x:Name="SyncNowBtn" Style="{StaticResource BrandButtonStyle}"
                                                Content="立即双向同步词库"
                                                Margin="0,0,8,6"
                                                Click="SyncNow_Click" />
                                        <Button x:Name="TestDavBtn" Style="{StaticResource GhostButtonStyle}"
                                                Content="保存并测试连接"
                                                Margin="0,0,8,6"
                                                Click="TestWebDav_Click" />
                                        <Button x:Name="RestoreProfileBtn" Style="{StaticResource GhostButtonStyle}"
                                                Content="从 WebDAV 一键恢复个人配置与词库"
                                                Margin="0,0,8,6"
                                                Click="RestoreProfile_Click" />
                                        <Button x:Name="BackupProfileBtn" Style="{StaticResource GhostButtonStyle}"
                                                Content="备份个人配置到 WebDAV"
                                                Margin="0,0,0,6"
                                                Click="BackupProfile_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- 万象语法模型 LTS 卡片 -->
                            <TextBlock Text="中文长句上下文预测（N-gram）" Style="{StaticResource SectionEyebrowStyle}" />
                            <Border Style="{StaticResource GlassCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="万象语法模型（wanxiang-lts-zh-hans.gram）" FontSize="15.5" FontWeight="Bold" />
                                            <TextBlock Text="约 398 MB 的 Rime 中文语言模型。安装后可显著提升整句长拼音与小鹤双拼的首选命中率；支持官方 LTS 仓库一键更新与断点续传。"
                                                       Style="{StaticResource RowDescStyle}" Margin="0,4,12,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" x:Name="GrammarBadge"
                                                Background="{DynamicResource WpSageSoftBrush}"
                                                CornerRadius="10" Padding="10,6" VerticalAlignment="Top">
                                            <TextBlock x:Name="GrammarBadgeText" Text="检测中..."
                                                       FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource WpSageBrush}" />
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource CardDividerStyle}" />

                                    <TextBlock x:Name="GrammarDetailText"
                                               Text="本地模型状态加载中..."
                                               FontSize="12.5" Foreground="{DynamicResource WpTextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,12" />

                                    <WrapPanel>
                                        <Button x:Name="CheckGrammarBtn" Style="{StaticResource GhostButtonStyle}"
                                                Content="检查云端 LTS 版本" Margin="0,0,8,4"
                                                Click="CheckGrammar_Click" />
                                        <Button x:Name="DownloadGrammarBtn" Style="{StaticResource BrandButtonStyle}"
                                                Content="下载 / 更新语法模型" Margin="0,0,8,4"
                                                Click="DownloadGrammar_Click" />
                                        <Button x:Name="CancelGrammarBtn" Style="{StaticResource GhostButtonStyle}"
                                                Content="暂停并保留断点缓存" Margin="0,0,8,4"
                                                Visibility="Collapsed"
                                                Click="CancelGrammar_Click" />
                                        <Button x:Name="DeleteGrammarBtn" Style="{StaticResource GhostButtonStyle}"
                                                Content="卸载模型" Margin="0,0,0,4"
                                                Foreground="{DynamicResource WpErrorBrush}"
                                                Click="DeleteGrammar_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════ TAB 2：输入与方案 ══════════════════ -->
                        <StackPanel x:Name="PageInput" Visibility="Collapsed">
                            <TextBlock Text="默认方案与打字行为" Style="{StaticResource SectionEyebrowStyle}" />

                            <Border Style="{StaticResource GlassCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="默认中文输入方案" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="公开版默认启用「雾凇全拼」，老用户也可随时切回「小鹤双拼」或从 WebDAV 恢复全套方案。"
                                               Style="{StaticResource RowDescStyle}" Margin="0,3,0,10" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <RadioButton x:Name="SchemaRimeIceRadio" Style="{StaticResource ChipRadioStyle}"
                                                     GroupName="PrimarySchema" Content="雾凇全拼（公开版默认）"
                                                     Checked="InputControl_Changed" />
                                        <RadioButton x:Name="SchemaFlypyRadio" Style="{StaticResource ChipRadioStyle}"
                                                     GroupName="PrimarySchema" Content="小鹤双拼（双拼高手推荐）"
                                                     Checked="InputControl_Changed" />
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="在选单中同时保留「全拼 + 小鹤双拼」" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock Text="开启后可在任意输入框按 F4 或 Ctrl+` 临时切换全拼/双拼，方便家人借用电脑或临时输入生僻字。"
                                                       Style="{StaticResource RowDescStyle}" />
                                        </StackPanel>
                                        <CheckBox x:Name="KeepBothSchemasCheck" Grid.Column="1" Style="{StaticResource PillSwitchStyle}"
                                                  Checked="InputControl_Changed" Unchecked="InputControl_Changed" />
                                    </Grid>

                                    <Border Style="{StaticResource CardDividerStyle}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="每页候选词数量" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock Text="公开版建议 5 个紧凑精炼候选；如需一页查看更多重码可调至 7 或 9。"
                                                       Style="{StaticResource RowDescStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton x:Name="PageSize5Radio" Style="{StaticResource ChipRadioStyle}" GroupName="PageSize" Content="5" Checked="InputControl_Changed" />
                                            <RadioButton x:Name="PageSize7Radio" Style="{StaticResource ChipRadioStyle}" GroupName="PageSize" Content="7" Checked="InputControl_Changed" />
                                            <RadioButton x:Name="PageSize9Radio" Style="{StaticResource ChipRadioStyle}" GroupName="PageSize" Content="9" Margin="0" Checked="InputControl_Changed" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource CardDividerStyle}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="启用万象语法模型整句预测权重" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock Text="在雾凇全拼与小鹤双拼中启用 wanxiang-lts-zh-hans 上下文语法模型，显著提升整句与双拼长句首选准确率。"
                                                       Style="{StaticResource RowDescStyle}" />
                                        </StackPanel>
                                        <CheckBox x:Name="GrammarEnabledCheck" Grid.Column="1" Style="{StaticResource PillSwitchStyle}"
                                                  Checked="InputControl_Changed" Unchecked="InputControl_Changed" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="模糊拼音与快捷键防误触" Style="{StaticResource SectionEyebrowStyle}" />
                            <Border Style="{StaticResource GlassCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="en ↔ eng 前后鼻音模糊（同时优化全拼与小鹤）" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock Text="关闭或开启不影响常规声母韵母输入；针对双拼会补齐 f/g/r/c/z/s/b/p/m/n 等精确韵母推导。"
                                                       Style="{StaticResource RowDescStyle}" />
                                        </StackPanel>
                                        <CheckBox x:Name="FuzzyEnEngCheck" Grid.Column="1" Style="{StaticResource PillSwitchStyle}"
                                                  Checked="InputControl_Changed" Unchecked="InputControl_Changed" />
                                    </Grid>

                                    <Border Style="{StaticResource CardDividerStyle}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="in ↔ ing 前后鼻音模糊" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock Text="允许「心(xin) / 星(xing)」「林(lin) / 零(ling)」互通候选匹配，打字无需反复斟酌后鼻音。"
                                                       Style="{StaticResource RowDescStyle}" />
                                        </StackPanel>
                                        <CheckBox x:Name="FuzzyInIngCheck" Grid.Column="1" Style="{StaticResource PillSwitchStyle}"
                                                  Checked="InputControl_Changed" Unchecked="InputControl_Changed" />
                                    </Grid>

                                    <Border Style="{StaticResource CardDividerStyle}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="平翘舌 zh/ch/sh ↔ z/c/s 模糊" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock Text="允许声母 z/c/s 与 zh/ch/sh（小鹤双拼对应 v/i/u）互相匹配。"
                                                       Style="{StaticResource RowDescStyle}" />
                                        </StackPanel>
                                        <CheckBox x:Name="FuzzyZhChShCheck" Grid.Column="1" Style="{StaticResource PillSwitchStyle}"
                                                  Checked="InputControl_Changed" Unchecked="InputControl_Changed" />
                                    </Grid>

                                    <Border Style="{StaticResource CardDividerStyle}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="小鹤双拼保留原文编码显示" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock Text="行内预编辑区直接展示键入的双拼字母（如 ui、dk），不展开还原为全拼音节。"
                                                       Style="{StaticResource RowDescStyle}" />
                                        </StackPanel>
                                        <CheckBox x:Name="KeepRawFlypyCheck" Grid.Column="1" Style="{StaticResource PillSwitchStyle}"
                                                  Checked="InputControl_Changed" Unchecked="InputControl_Changed" />
                                    </Grid>

                                    <Border Style="{StaticResource CardDividerStyle}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="禁用 Shift 误触，仅用 Ctrl+Space 切换中英文" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock Text="防止写代码或全选时随手按下左/右 Shift 导致输入法意外切到英文模式（个人常用防误触设定）。"
                                                       Style="{StaticResource RowDescStyle}" />
                                        </StackPanel>
                                        <CheckBox x:Name="CtrlSpaceOnlyCheck" Grid.Column="1" Style="{StaticResource PillSwitchStyle}"
                                                  Checked="InputControl_Changed" Unchecked="InputControl_Changed" />
                                    </Grid>

                                    <Border Style="{StaticResource CardDividerStyle}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="使用 Tab 键向后翻页" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock Text="修复上游默认配置中 Tab 切分音节问题，允许在候选栏弹出时用 Tab 快速向后翻页（Shift+Tab 上一页）。"
                                                       Style="{StaticResource RowDescStyle}" />
                                        </StackPanel>
                                        <CheckBox x:Name="TabPageFlipCheck" Grid.Column="1" Style="{StaticResource PillSwitchStyle}"
                                                  Checked="InputControl_Changed" Unchecked="InputControl_Changed" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button x:Name="ApplyRimeBtn" Style="{StaticResource BrandButtonStyle}"
                                                Content="保存输入方案并部署生效"
                                                Click="ApplyRimeConfig_Click" />
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                Margin="10,0,0,0"
                                                Content="从当前配置重新读取"
                                                Click="ReloadState_Click" />
                                        <Border x:Name="InputDirtyBadge" Visibility="Collapsed"
                                                Background="{DynamicResource WpBrandSoftBrush}"
                                                BorderBrush="{DynamicResource WpBrandBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="10,5" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="有未部署更改" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource WpBrandInkBrush}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════ TAB 3：外观与皮肤 ══════════════════ -->
                        <StackPanel x:Name="PageSkin" Visibility="Collapsed">
                            <TextBlock Text="控制中心界面主题" Style="{StaticResource SectionEyebrowStyle}" />

                            <Border Style="{StaticResource GlassCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="暖纸液态玻璃明暗模式" Style="{StaticResource RowTitleStyle}" />
                                        <TextBlock Text="控制当前设置界面的浅色（羊皮暖白）/ 深色（暖炭黑）配色，默认自动跟随 Windows 系统。"
                                                   Style="{StaticResource RowDescStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="UiAutoRadio" Style="{StaticResource ChipRadioStyle}"
                                                     GroupName="UiMode" Content="跟随系统" Checked="UiModeRadio_Checked" />
                                        <RadioButton x:Name="UiLightRadio" Style="{StaticResource ChipRadioStyle}"
                                                     GroupName="UiMode" Content="羊皮浅色" Checked="UiModeRadio_Checked" />
                                        <RadioButton x:Name="UiDarkRadio" Style="{StaticResource ChipRadioStyle}"
                                                     GroupName="UiMode" Content="暖炭深色" Margin="0" Checked="UiModeRadio_Checked" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="小狼毫候选框皮肤预设（支持浅/深色自动切换）" Style="{StaticResource SectionEyebrowStyle}" />
                            <Border Style="{StaticResource GlassCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="选择候选窗主题配色" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="「Claude 陶土橙」与手机端 1.2.1 公开版完全统一；「跟随 Windows 主体色」会自动采集系统个性色生成高对比昼夜双配色。"
                                               Style="{StaticResource RowDescStyle}" Margin="0,3,0,10" />

                                    <WrapPanel Margin="0,0,0,12">
                                        <RadioButton x:Name="SkinTerracottaRadio" Style="{StaticResource ChipRadioStyle}"
                                                     GroupName="SkinPreset" Content="Claude 陶土橙（默认推荐）"
                                                     Checked="SkinControl_Changed" />
                                        <RadioButton x:Name="SkinSystemAccentRadio" Style="{StaticResource ChipRadioStyle}"
                                                     GroupName="SkinPreset" Content="跟随 Windows 主体色"
                                                     Checked="SkinControl_Changed" />
                                        <RadioButton x:Name="SkinAmberRadio" Style="{StaticResource ChipRadioStyle}"
                                                     GroupName="SkinPreset" Content="暖纸琥珀"
                                                     Checked="SkinControl_Changed" />
                                    </WrapPanel>

                                    <!-- 实时浅色/深色双候选栏预览 -->
                                    <Border Background="{DynamicResource WpCardSubtleBrush}"
                                            BorderBrush="{DynamicResource WpBorderStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14" Padding="14,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <TextBlock Text="实时候选条效果预览（浅色模式 / 深色模式）"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource WpTextSecondaryBrush}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Ellipse x:Name="AccentSwatchDot" Width="11" Height="11" Margin="0,0,6,0" />
                                                    <TextBlock x:Name="AccentHexText" Text="当前系统主体色 #D97757"
                                                               FontSize="11.5" Foreground="{DynamicResource WpMutedBrush}" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 浅色候选预览 -->
                                                <Border x:Name="PreviewLightBox" Grid.Column="0"
                                                        BorderThickness="1" CornerRadius="8" Padding="10,7">
                                                    <StackPanel>
                                                        <TextBlock x:Name="PreviewLightPreedit" Text="shurufa" FontSize="12" Margin="0,0,0,5" />
                                                        <WrapPanel VerticalAlignment="Center">
                                                            <Border x:Name="PreviewLightHilitePill" CornerRadius="5" Padding="7,3" Margin="0,0,8,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock x:Name="PreviewLightHiliteLbl" Text="1." FontSize="11.5" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="PreviewLightHiliteTxt" Text="输入法" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBlock x:Name="PreviewLightCand2" Text="2. 舒舒服服" FontSize="13.5" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                            <TextBlock x:Name="PreviewLightCand3" Text="3. 书" FontSize="13.5" VerticalAlignment="Center" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- 深色候选预览 -->
                                                <Border x:Name="PreviewDarkBox" Grid.Column="2"
                                                        BorderThickness="1" CornerRadius="8" Padding="10,7">
                                                    <StackPanel>
                                                        <TextBlock x:Name="PreviewDarkPreedit" Text="shurufa" FontSize="12" Margin="0,0,0,5" />
                                                        <WrapPanel VerticalAlignment="Center">
                                                            <Border x:Name="PreviewDarkHilitePill" CornerRadius="5" Padding="7,3" Margin="0,0,8,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock x:Name="PreviewDarkHiliteLbl" Text="1." FontSize="11.5" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="PreviewDarkHiliteTxt" Text="输入法" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBlock x:Name="PreviewDarkCand2" Text="2. 舒舒服服" FontSize="13.5" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                            <TextBlock x:Name="PreviewDarkCand3" Text="3. 书" FontSize="13.5" VerticalAlignment="Center" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardDividerStyle}" />

                                    <!-- 排版参数 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="候选条间距密度" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock Text="「紧凑微胶囊」适合高分屏少遮挡文字；「舒适标准」留白更充裕。"
                                                       Style="{StaticResource RowDescStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton x:Name="DensityCompactRadio" Style="{StaticResource ChipRadioStyle}"
                                                         GroupName="Density" Content="紧凑微胶囊" Checked="SkinControl_Changed" />
                                            <RadioButton x:Name="DensityStandardRadio" Style="{StaticResource ChipRadioStyle}"
                                                         GroupName="Density" Content="舒适标准" Margin="0" Checked="SkinControl_Changed" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource CardDividerStyle}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="候选文字字号（pt）" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock Text="默认 12 pt（编号与编码提示自动缩减 1 pt，层次更分明）。"
                                                       Style="{StaticResource RowDescStyle}" />
                                        </StackPanel>
                                        <Slider x:Name="FontSlider" Grid.Column="1" Minimum="10" Maximum="18"
                                                IsSnapToTickEnabled="True" TickFrequency="1"
                                                VerticalAlignment="Center" ValueChanged="SkinSlider_ValueChanged" />
                                        <TextBlock x:Name="FontValueText" Grid.Column="2" Text="12"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </Grid>

                                    <Border Style="{StaticResource CardDividerStyle}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="窗口外边框圆角半径" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock Text="默认 7 px，高亮候选胶囊自动内缩 2 px 以呈现和谐同心圆角。"
                                                       Style="{StaticResource RowDescStyle}" />
                                        </StackPanel>
                                        <Slider x:Name="CornerSlider" Grid.Column="1" Minimum="0" Maximum="14"
                                                IsSnapToTickEnabled="True" TickFrequency="1"
                                                VerticalAlignment="Center" ValueChanged="SkinSlider_ValueChanged" />
                                        <TextBlock x:Name="CornerValueText" Grid.Column="2" Text="7"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </Grid>

                                    <Border Style="{StaticResource CardDividerStyle}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="后台自动跟随 Windows 主体色变化" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock Text="在系统托盘以极低内存监听系统壁纸取色或明暗切换；当皮肤选为「跟随 Windows 主体色」时自动更新并部署。"
                                                       Style="{StaticResource RowDescStyle}" />
                                        </StackPanel>
                                        <CheckBox x:Name="AutoAccentTrayCheck" Grid.Column="1" Style="{StaticResource PillSwitchStyle}"
                                                  Checked="SkinControl_Changed" Unchecked="SkinControl_Changed" />
                                    </Grid>

                                    <Border Style="{StaticResource CardDividerStyle}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="禁止特定应用强制切换为英文" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock Text="清空上游默认对终端/代码编辑器强切英文规则，切窗始终保留当前中英文输入态，避免输入焦点混乱。"
                                                       Style="{StaticResource RowDescStyle}" />
                                        </StackPanel>
                                        <CheckBox x:Name="DisableForcedAsciiCheck" Grid.Column="1" Style="{StaticResource PillSwitchStyle}"
                                                  Checked="SkinControl_Changed" Unchecked="SkinControl_Changed" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button x:Name="ApplySkinBtn" Style="{StaticResource BrandButtonStyle}"
                                                Content="保存外观皮肤并立即生效"
                                                Click="ApplySkin_Click" />
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                Margin="10,0,0,0"
                                                Content="重新采集 Windows 主体色"
                                                Click="RefreshSystemColor_Click" />
                                        <Border x:Name="SkinDirtyBadge" Visibility="Collapsed"
                                                Background="{DynamicResource WpBrandSoftBrush}"
                                                BorderBrush="{DynamicResource WpBrandBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="10,5" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="有未部署更改" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource WpBrandInkBrush}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════ TAB 4：工具与关于 ══════════════════ -->
                        <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                            <TextBlock Text="系统整合与快捷维护" Style="{StaticResource SectionEyebrowStyle}" />

                            <Border Style="{StaticResource GlassCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="微软拼音接管与系统精简" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock x:Name="MsPinyinStatusText"
                                                       Text="检测微软拼音输入法状态中..."
                                                       Style="{StaticResource RowDescStyle}" />
                                        </StackPanel>
                                        <Button x:Name="RemoveMsPinyinBtn" Grid.Column="1"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Content="移除微软拼音"
                                                Click="RemoveMsPinyin_Click" />
                                    </Grid>

                                    <Border Style="{StaticResource CardDividerStyle}" />

                                    <TextBlock Text="常用数据文件与运行目录" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="自定义短语在修改保存后，点击左侧「立即部署小狼毫」即可全局生效。"
                                               Style="{StaticResource RowDescStyle}" Margin="0,2,0,10" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource GhostButtonStyle}" Content="打开 Rime 用户目录"
                                                Margin="0,0,8,8" Click="OpenRimeFolder_Click" />
                                        <Button Style="{StaticResource GhostButtonStyle}" Content="编辑全拼短语 (custom_phrase.txt)"
                                                Margin="0,0,8,8" Click="EditFullPhrase_Click" />
                                        <Button Style="{StaticResource GhostButtonStyle}" Content="编辑双拼短语 (custom_phrase_double.txt)"
                                                Margin="0,0,8,8" Click="EditDoublePhrase_Click" />
                                        <Button x:Name="RestartWeaselBtn" Style="{StaticResource GhostButtonStyle}" Content="重启 WeaselServer 服务"
                                                Margin="0,0,0,8" Click="RestartWeasel_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="版本、开源仓库与核心组件致谢" Style="{StaticResource SectionEyebrowStyle}" />
                            <Border Style="{StaticResource GlassCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Ifboard for Windows（公开版 v1.2.1）" FontSize="15" FontWeight="Bold" />
                                            <TextBlock x:Name="AppUpdateInfoText"
                                                       Text="暖纸液态玻璃桌面控制中心 · 已完整打包小狼毫 0.17.4、雾凇拼音、小鹤双拼与万象语法模型生态。"
                                                       Style="{StaticResource RowDescStyle}" Margin="0,4,12,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button x:Name="CheckAppUpdateBtn" Style="{StaticResource GhostButtonStyle}"
                                                    Content="检查新版本" Margin="0,0,8,0"
                                                    Click="CheckAppUpdate_Click" />
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Content="GitHub 主页"
                                                    Click="OpenGithub_Click" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource CardDividerStyle}" />

                                    <TextBlock Text="开源驱动致谢" Style="{StaticResource RowTitleStyle}" Margin="0,0,0,6" />
                                    <TextBlock Style="{StaticResource RowDescStyle}" Margin="0">
                                        <Run Text="• 输入引擎：Rime / 小狼毫 Weasel 0.17.4（GPL-3.0 协议）" /><LineBreak />
                                        <Run Text="• 词库与方案：雾凇拼音（rime-ice 全拼 + 小鹤双拼 + 拆字反查 + 英文混输）" /><LineBreak />
                                        <Run Text="• 长句语法模型：amzxyz/rime-wanxiang-data 万象中文语法模型 LTS" /><LineBreak />
                                        <Run Text="• 美术系统：Warm Paper · Liquid Glass（羊皮暖白 × Claude 陶土橙 × Windows 系统取色引擎）" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
